# --- Database (dev lokal) ---
DATABASE_URL="postgresql://pspk:pspk_dev_password@localhost:5432/pspk_platform"

# --- URL aplikasi ---
HRIS_URL="http://localhost:3001"
SYSMGMT_URL="http://localhost:3002"

# --- Auth ---
AUTH_SECRET="ganti-dengan-hasil-openssl-rand-base64-32"
BETTER_AUTH_SECRET="ganti-dengan-hasil-openssl-rand-base64-32"
AUTH_COOKIE_DOMAIN=""            # kosong di lokal; produksi mis. ".domain-pspk.example"

# --- Enkripsi kolom sensitif (NIK, NPWP, rekening) ---
DATA_ENCRYPTION_KEY="ganti-dengan-hasil-openssl-rand-base64-32"

# --- Storage ---
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./.data/uploads"
MAX_UPLOAD_MB="25"

# --- Lain-lain ---
APP_TIMEZONE="Asia/Jakarta"      # zona waktu operasional

# --- Google Calendar & OAuth (Libur Nasional & Integrasi Google Meet Pribadi) ---
GOOGLE_CALENDAR_API_KEY=""          # API Key untuk sinkronisasi libur nasional tanpa login
GOOGLE_CLIENT_ID=""                 # OAuth 2.0 Web Client ID untuk login & sync meeting pribadi
GOOGLE_CLIENT_SECRET=""             # OAuth 2.0 Client Secret
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3001/api/calendar/google/callback"
CRON_SECRET=""                      # Secret token untuk trigger webhook cron auto-sync

# --- Email / SMTP (Pengiriman Email Kredensial & Notifikasi Otomatis) ---
SMTP_HOST="smtp.gmail.com"          # Host SMTP (misal: smtp.gmail.com atau mail.pspk.id)
SMTP_PORT="587"                     # Port SMTP: 587 (TLS) atau 465 (SSL)
SMTP_USER=""                        # Email pengirim (misal: notifikasi@pspk.id)
SMTP_PASS=""                        # Password aplikasi (Google App Password 16 karakter)
SMTP_FROM="PSPK HRIS <noreply@pspk.id>" # Nama & email pengirim

# --- Seed (hanya untuk dev) ---
SEED_ADMIN_EMAIL="superadmin@pspk.id"
SEED_ADMIN_PASSWORD="Superadmin321!"
SEED_DEMO="false"


