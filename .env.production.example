# ==============================================================================
# PSPK Platform — Contoh Konfigurasi Lingkungan Produksi (VPS + Docker)
# Salin file ini menjadi .env.production di VPS Anda saat siap deploy.
# ==============================================================================

# --- Domain & Routing Publik (Caddy otomatis mengurus HTTPS) ---
HRIS_DOMAIN=hris.pspk.id
SYSMGMT_DOMAIN=sysmgmt.pspk.id
AUTH_COOKIE_DOMAIN=.pspk.id             # Prefix titik penting untuk SSO lintas subdomain

# --- Kredensial Database PostgreSQL (Container Docker VPS) ---
POSTGRES_DB=pspk_platform
POSTGRES_USER=pspk_owner               # PostgreSQL superuser di container (untuk inisialisasi)
POSTGRES_PASSWORD=ganti-dengan-password-owner-kuat-32char
APP_DB_USER=pspk_app                   # User aplikasi (hak terbatas: SELECT/INSERT/UPDATE/DELETE)
APP_DB_PASSWORD=ganti-dengan-password-app-kuat-32char


# --- Keamanan & Enkripsi Kunci Rahasia ---
# Hasilkan nilai acak aman menggunakan: openssl rand -base64 32
AUTH_SECRET=ganti-dengan-hasil-openssl-rand-base64-32
BETTER_AUTH_SECRET=ganti-dengan-hasil-openssl-rand-base64-32
DATA_ENCRYPTION_KEY=ganti-dengan-hasil-openssl-rand-base64-32

# --- Storage & Upload Dokumen ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/app/uploads
MAX_UPLOAD_MB=25

# --- Zona Waktu Operasional ---
APP_TIMEZONE=Asia/Jakarta

# --- Email / SMTP (Pengiriman Email Kredensial & Notifikasi Otomatis) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifikasi@pspk.id
SMTP_PASS=ganti-dengan-app-password-16-karakter
SMTP_FROM="PSPK HRIS <noreply@pspk.id>"

# --- Google Calendar & OAuth (Libur Nasional, Meet & Cron Auto-Sync) ---
GOOGLE_CALENDAR_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://hris.pspk.id/api/calendar/google/callback
CRON_SECRET=ganti-dengan-token-rahasia-cron-webhook
